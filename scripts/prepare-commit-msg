#!/bin/sh
# Append the assistant attribution trailer to every commit message.
# Copied into .git/hooks/prepare-commit-msg by scripts/install-hooks.sh.
msgfile="$1"
[ -n "$msgfile" ] || exit 0
[ -f "$msgfile" ] || exit 0

if grep -qi '^Assisted-by:' "$msgfile"; then
    exit 0
fi

# Keep the message body and trailers separated by exactly one blank line.
if [ -s "$msgfile" ]; then
    printf '\n' >> "$msgfile"
fi
printf 'Assisted-by: DeepSeek V4.1 flash\n' >> "$msgfile"
